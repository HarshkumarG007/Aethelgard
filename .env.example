# Site Origin & Environment
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
APP_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://aethelgard:dev-only-password@localhost:5432/aethelgard

# Cloudflare R2 Media Storage (Production mandatory, dev optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aethelgard-private

# Local Media Storage Directory (Development only)
LOCAL_MEDIA_DIR=./.dev-media

# Authentication Passphrases (Used by npm run db:seed to provision users)
VIEWER_PASSPHRASE=
ADMIN_PASSPHRASE=

# Distributed Rate Limiting (Upstash Redis, Production)
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=

# Monitoring & Error Reporting (Scrubbed)
SENTRY_DSN=
